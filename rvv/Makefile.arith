# --- Setup ---
CROSS_COMPILE = riscv64-unknown-linux-gnu-
CC      = $(CROSS_COMPILE)gcc
CXX     = $(CROSS_COMPILE)g++
AS      = $(CROSS_COMPILE)as
OBJDUMP = $(CROSS_COMPILE)objdump

# Default SEW width if not specified via `make SEW=64`
SEW ?= 32

TARGET  = rvv_arith_latency_$(SEW).bin
DUMP    = $(TARGET).dump

# gem5 paths (Ensure these point to your local gem5 install)
GEM5_DIR = /gem5
M5_INCLUDE = $(GEM5_DIR)/include
M5_LIB_DIR = $(GEM5_DIR)/util/m5/build/riscv/out

# --- Flags ---
# -O3 is required for auto-vectorization
# -march=rv64gcv enables the 'V' extension for vectors
VECTOR_FLAGS = -O3 -march=rv64gcv_zvfh -mabi=lp64d -fopt-info-vec-optimized

# Base flags used by both C and C++
COMMON_FLAGS = -static -I$(M5_INCLUDE) $(VECTOR_FLAGS) -DSEW=$(SEW)

CFLAGS   = $(COMMON_FLAGS)
CXXFLAGS = $(COMMON_FLAGS) -std=c++17  # Standard C++17 or higher
LDFLAGS  = -static -L$(M5_LIB_DIR) -lm5

# --- Files ---
C_SRCS     = 
CXX_SRCS   = rvv_arith_latency.c
ASM_SRCS   = 

# Object mapping for all source types
OBJS = $(C_SRCS:.c=.o) $(CXX_SRCS:.cpp=.o) $(ASM_SRCS:.S=.o)

# --- Rules ---
all: $(TARGET) $(DUMP)

# Link using CXX so the C++ standard libraries are included automatically
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(DUMP): $(TARGET)
	$(OBJDUMP) -d -S -C -l $< > $@
	@echo "Generated dump file with C++ demangling: $@"

# Rule for C++ files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Rule for C files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Rule for Assembly files
%.o: %.S
	$(AS) -march=rv64gcv -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET) $(DUMP)

.PHONY: all clean
